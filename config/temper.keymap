/*
 * Temper Right – Single Hand
 * Capas:
 *   0 - Numpad
 *   1 - Media / Screenshots / Volumen
 *   2 - Blender / Unity (3D)
 *   3 - System (Bluetooth, Outputs)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define MEDIA   1
#define SOFT    2
#define SYS     3

#define ______ &trans

/ {
    behaviors {
        mo_media: mo_media {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // =====================================================
        // Capa 0 – NUMPAD
        // =====================================================
        default_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp N7          &kp N8          &kp N9          &kp KP_MULTIPLY   &kp BSPC
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp N4          &kp N5          &kp N6          &kp KP_MINUS      &kp TAB
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp N1          &kp N2          &kp N3          &kp KP_PLUS       &kp RET
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤
                                    &mo MEDIA       &kp N0            &kp KP_DOT
//                              ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        // =====================================================
        // Capa 1 – MEDIA / VOLUMEN / SCREENSHOTS
        // =====================================================
        media_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp C_VOL_UP    &kp C_MUTE      &kp C_VOL_DN    &kp C_BRI_UP      &kp PSCRN
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp C_BRI_DN      &kp LG(LS(N4))
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp C_REWIND    &kp C_EJECT     &kp C_FAST      ______            &kp LG(LS(N5))
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤
                                    &to DEFAULT     &mo SOFT          &mo SYS
//                              ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        // =====================================================
        // Capa 2 – BLENDER / UNITY (atajos 3D)
        // =====================================================
        soft_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp G           &kp R           &kp S           &kp E             &kp TAB
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp X           &kp Y           &kp Z           &kp KP_DOT        &kp DEL
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp A           &kp B           &kp C           &kp F             &kp RET
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤
                                    &to DEFAULT     ______            &mo SYS
//                              ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        // =====================================================
        // Capa 3 – SYSTEM (Bluetooth + Outputs)
        // =====================================================
        sys_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3      &bt BT_SEL 4
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &out OUT_USB    &out OUT_BLE    &bt BT_CLR      ______            ______
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &to DEFAULT     &to MEDIA       &to SOFT        ______            ______
// ╰─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤
                                    ______          ______            ______
//                              ╰─────────────┴─────────────┴─────────────╯
            >;
        };
    };
};
