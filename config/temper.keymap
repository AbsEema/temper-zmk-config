#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define MEDIA   1
#define SOFT    2
#define SYS     3

#define ______ &trans

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    &kp N8   &kp N9   &kp KP_MULTIPLY   &kp BSPC
    &kp N5   &kp N6   &kp KP_MINUS      &kp TAB
    &kp N2   &kp N3   &kp KP_PLUS       &kp RET
             &mo MEDIA &kp N0           &kp KP_DOT
            >;
        };

        media_layer {
            bindings = <
    &kp C_VOL_UP  &kp C_MUTE  &kp C_VOL_DN  &kp PSCRN
    &kp C_PREV    &kp C_PP    &kp C_NEXT    ______
    &kp C_BRI_UP  &kp C_BRI_DN ______       ______
                  &to DEFAULT &mo SOFT      &mo SYS
            >;
        };

        soft_layer {
            bindings = <
    &kp R  &kp S  &kp E  &kp TAB
    &kp Y  &kp Z  &kp KP_DOT  &kp DEL
    &kp B  &kp C  &kp F  &kp RET
           &to DEFAULT ______  &mo SYS
            >;
        };

        sys_layer {
            bindings = <
    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
    &out OUT_USB  &out OUT_BLE  &bt BT_CLR    ______
    &to DEFAULT   &to MEDIA     &to SOFT      ______
                  ______        ______        ______
            >;
        };
    };
};
